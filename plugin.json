{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tether-browser",
  "version": "0.1.32",
  "description": "Remote-to-local browser automation bridge for AI coding agents across Herdr, tmux, and SSH. Controls Google Chrome on the developer's laptop with native 2FA/Passkeys, tab groups, accessibility snapshots, and visual review notes.",
  "author": {
    "name": "Jeff Huen",
    "url": "https://github.com/jeffhuen"
  },
  "homepage": "https://github.com/jeffhuen/tether-browser",
  "repository": "https://github.com/jeffhuen/tether-browser",
  "license": "MIT",
  "keywords": [
    "browser",
    "automation",
    "agent-browser",
    "cdp",
    "chrome",
    "passkeys",
    "2fa",
    "tab-groups",
    "design-review",
    "orca"
  ],
  "skills": "./skills/",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Tether Browser"
      }
    }
  }
}
