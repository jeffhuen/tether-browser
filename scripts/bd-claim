#!/usr/bin/env bash
# Claim a beads issue, stamping agent label + durable claim metadata.
#
#   scripts/bd-claim <issue-id>
#
# Adds one agent:* label (swapping any other), and stores claim_agent +
# claim_session_id metadata for cold-start handoff and resume tooling.
#
# Honors BD_AGENT_LABEL / BD_AGENT_NAME / BD_SESSION_ID overrides via
# scripts/bd-agent-context. Use those env vars for explicit handoffs:
#
#   BD_AGENT_NAME=codex scripts/bd-claim sbr-123
#   BD_SESSION_ID=manual-abc scripts/bd-claim sbr-123

set -euo pipefail

id="${1:?usage: bd-claim <issue-id>}"

dir="$(cd "$(dirname "$0")" && pwd)"
eval "$("$dir/bd-agent-context" --shell)"

remove_args=()
for other in claude codex gemini unknown; do
  if [[ "$BD_AGENT_NAME" != "$other" ]]; then
    remove_args+=(--remove-label "agent:$other")
  fi
done

bd update "$id" --claim \
  --add-label "$BD_AGENT_LABEL" \
  "${remove_args[@]}" \
  --set-metadata "claim_agent=$BD_AGENT_NAME" \
  --set-metadata "claim_session_id=$BD_SESSION_ID"
