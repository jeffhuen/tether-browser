#!/usr/bin/env bash
# Detect the current agent runtime and session id for beads claim metadata.
#
#   scripts/bd-agent-context           # human-readable
#   scripts/bd-agent-context --shell   # eval-friendly exports (shell-quoted)
#
# Overrides:
#   BD_AGENT_LABEL  e.g. "agent:codex" — sets agent, skips runtime detection
#   BD_AGENT_NAME   e.g. "codex"       — sets agent, skips runtime detection
#   BD_SESSION_ID   independent — overrides session id regardless of agent source
#
# Auto-detection precedence (when no BD_AGENT_* override):
#   Claude Code → CLAUDE_CODE_SESSION_ID, then CLAUDE_SESSION_ID
#   Codex       → CODEX_THREAD_ID
#   Gemini CLI  → $HOME/.gemini/tmp/$(basename $PWD)/logs.json (jq)
#   Fallback    → agent:unknown / session_id=unknown
#
# No cross-project log glob — silent project leak is worse than unknown.

set -euo pipefail

agent=unknown
session_id=unknown

if [[ -n "${BD_AGENT_LABEL:-}" ]]; then
  agent="${BD_AGENT_LABEL#agent:}"
elif [[ -n "${BD_AGENT_NAME:-}" ]]; then
  agent="$BD_AGENT_NAME"
elif [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
  agent=claude
  session_id="$CLAUDE_CODE_SESSION_ID"
elif [[ -n "${CLAUDE_SESSION_ID:-}" ]]; then
  agent=claude
  session_id="$CLAUDE_SESSION_ID"
elif [[ -n "${CODEX_THREAD_ID:-}" ]] || [[ -n "${CODEX_SESSION_ID:-}" ]]; then
  agent=codex
  session_id="${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-unknown}}"
elif [[ -n "${OPENCODE:-}" ]] || [[ -n "${OPENCODE_SESSION_ID:-}" ]]; then
  agent=opencode
  session_id="${OPENCODE_SESSION_ID:-${HERDR_PANE_ID:-unknown}}"
elif [[ -n "${GROK_CLI:-}" ]] || [[ -n "${GROK_SESSION_ID:-}" ]] || [[ -n "${XAI_CLI:-}" ]]; then
  agent=grok
  session_id="${GROK_SESSION_ID:-${HERDR_PANE_ID:-unknown}}"
elif [[ -n "${PI_SESSION_ID:-}" ]] || [[ -n "${PI_AGENT_SESSION_ID:-}" ]]; then
  agent=pi
  session_id="${PI_SESSION_ID:-${PI_AGENT_SESSION_ID:-${HERDR_PANE_ID:-unknown}}}"
elif [[ -n "${OMPCODE:-}" ]]; then
  agent=omp
  session_id="${HERDR_PANE_ID:-$$}"
elif [[ -n "${GEMINI_CLI:-}" ]] || [[ -n "${ANTIGRAVITY_CLI:-}" ]] || [[ -n "${AGY:-}" ]]; then
  agent=gemini
  log="$HOME/.gemini/tmp/$(basename "$PWD")/logs.json"
  if [[ -f "$log" ]] && command -v jq >/dev/null 2>&1; then
    session_id=$(jq -r '.[-1].sessionId // "unknown"' "$log" 2>/dev/null || echo unknown)
  else
    session_id="${HERDR_PANE_ID:-unknown}"
  fi
elif [[ "${HERDR_ENV:-}" == "1" ]]; then
  agent=herdr
  session_id="${HERDR_PANE_ID}"
fi

# BD_SESSION_ID is an independent override — applies regardless of agent source.
if [[ -n "${BD_SESSION_ID:-}" ]]; then
  session_id="$BD_SESSION_ID"
fi

agent="${agent:-unknown}"

if [[ "${1:-}" == "--shell" ]]; then
  printf 'export BD_AGENT_NAME=%q\n' "$agent"
  printf 'export BD_AGENT_LABEL=%q\n' "agent:$agent"
  printf 'export BD_SESSION_ID=%q\n' "$session_id"
else
  printf 'agent_name=%s\n' "$agent"
  printf 'agent_label=agent:%s\n' "$agent"
  printf 'session_id=%s\n' "$session_id"
fi
