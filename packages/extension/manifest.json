{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "Tether Browser Bridge",
  "version": "0.1.32",
  "description": "Remote-to-local browser bridge for AI agents with native tab groups",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "debugger",
    "tabGroups",
    "tabs",
    "nativeMessaging",
    "proxy",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tether Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
