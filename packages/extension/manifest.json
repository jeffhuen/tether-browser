{
  "manifest_version": 3,
  "name": "Tether Browser Bridge",
  "version": "0.1.21",
  "description": "High-performance remote browser automation bridge for AI coding agents with native tab groups",
  "key": "",
  "permissions": [
    "debugger",
    "tabGroups",
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tether Browser Bridge",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["review/overlay.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
